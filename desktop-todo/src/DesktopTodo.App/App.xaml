<Application x:Class="DesktopTodo.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown"><Application.Resources>
<SolidColorBrush x:Key="PanelBackground" Color="#DDD9E3"/><SolidColorBrush x:Key="PanelForeground" Color="#4C435A"/><SolidColorBrush x:Key="PanelAccent" Color="#7F6890"/><SolidColorBrush x:Key="PanelBorder" Color="#B7ABD4"/><SolidColorBrush x:Key="MutedForeground" Color="#7F6890"/><SolidColorBrush x:Key="FieldBackground" Color="#DDD9E3"/><SolidColorBrush x:Key="SelectionBackground" Color="#B7ABD4"/><SolidColorBrush x:Key="AccentInk" Color="White"/>
<Style TargetType="Button"><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="{DynamicResource PanelBackground}"/><Setter Property="Foreground" Value="{DynamicResource PanelForeground}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PanelAccent}"/><Setter TargetName="border" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="{DynamicResource FieldBackground}"/><Setter Property="Foreground" Value="{DynamicResource PanelForeground}"/><Setter Property="CaretBrush" Value="{DynamicResource PanelForeground}"/><Setter Property="SelectionBrush" Value="{DynamicResource SelectionBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/></Style>
<Style TargetType="ComboBox"><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="FontSize" Value="14"/></Style>
<Style TargetType="DatePicker"><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="FontSize" Value="14"/></Style>
<Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7,0,8"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource PanelForeground}"/></Style>
</Application.Resources></Application>
